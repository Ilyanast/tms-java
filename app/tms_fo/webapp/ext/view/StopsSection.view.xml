<mvc:View
    controllerName="tmsfo.ext.controller.StopsSection"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.ui.table"
    xmlns:dnd="sap.ui.core.dnd"
    xmlns:m="sap.m"
    xmlns:rm="sap.ui.table.rowmodes">

    <Table
        id="StopsDndTable"
        rows="{path: 'stops'}"
        selectionMode="None">

        <rowMode>
            <rm:Auto id="StopsAutoRowMode"/>
        </rowMode>

        <dragDropConfig>
            <dnd:DragDropInfo
                id="StopsDndDragDrop"
                sourceAggregation="rows"
                targetAggregation="rows"
                dropPosition="Between"
                dragStart="onDragStart"
                drop="onDrop"/>
        </dragDropConfig>

        <columns>

            <Column id="StopsColSequence" width="6rem">
                <label>
                    <m:Label
                        id="StopsColSequenceLabel"
                        text="Sequence"/>
                </label>
                <template>
                    <m:Text
                        id="StopsColSequenceText"
                        text="{sequence}"/>
                </template>
            </Column>

            <Column id="StopsColLocation">
                <label>
                    <m:Label
                        id="StopsColLocationLabel"
                        text="Location"/>
                </label>
                <template>
                    <m:Text
                        id="StopsColLocationText"
                        text="{location/name}"/>
                </template>
            </Column>

        </columns>
    </Table>

</mvc:View>
